# Node / frontend
node_modules/
dist/
dist-electron/
release/
*.log

# Python / backend
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
backend/build/
backend/dist/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo

# Base Local (SQLite) e arquivos temporários de escrita atômica — nunca
# gerados dentro do repo em uso normal (vivem em %APPDATA%/ExtratorDiarias),
# mas ignorados aqui por segurança caso algum script/teste os crie localmente.
*.sqlite
*.sqlite3
*.db
*.tmp
*.cadastro.tmp.*

# Screenshots/provas ad-hoc soltas na raiz do repo (nunca as intencionais de
# docs/screenshots/, que continuam versionadas).
/prova-*.png
/prova-*.json
/normal-*.png

# Segredos e configuração local — nunca versionar
.env
.env.*

# Cópias de teste da planilha oficial e pastas de resultados geradas a
# partir dela (contêm dados reais — nunca versionar)
tests/e2e/fixtures/*.xlsx
tests/e2e/fixtures/relatorio_*.txt
tests/e2e/fixtures/resultado_*/

# Política permanente (Sprint 10): nenhum documento/processo/planilha real
# pode ser versionado, mesmo em pastas de fixtures futuras — ver
# CONTRIBUTING.md e backend/tests/fixtures/gerar_fixtures_sinteticas.py.
**/fixtures/**/*_real*
**/fixtures/**/*_producao*

# Saída gerada ao rodar scripts/demo (planilha preenchida, relatório, log
# desta execução local) — só os PDFs/planilha de entrada em scripts/demo/
# são versionados, nunca o resultado de rodar o app sobre eles.
scripts/demo/resultado_*/

# Micro-Sprint 3F — template/relatório oficial real do Portal da
# Transparência, usado READ-ONLY como referência de estrutura/formatação
# para o gerador XLSX. Mesma política permanente acima: nunca versionar.
/RELATÓRIO DIÁRIAS PORTAL DA TRANSPARENCIA*.xlsx
/scratch-3f/
